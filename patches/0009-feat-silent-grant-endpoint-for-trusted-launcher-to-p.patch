diff --git a/packages/core/src/routes/winamz/silent-grant.ts b/packages/core/src/routes/winamz/silent-grant.ts
new file mode 100644
index 000000000..160c36f33
--- /dev/null
+++ b/packages/core/src/routes/winamz/silent-grant.ts
@@ -0,0 +1,124 @@
+/**
+ * [winamz] New file - silent SSO endpoint for trusted launcher.
+ *
+ * Allows winamz-launcher (after headless-login obtains a logto access_token)
+ * to "prime" a logto sign-in session cookie in the launcher's main webview,
+ * so that any embedded child webview (vikunja / future) gets silent SSO when
+ * doing OIDC code flow against logto — no user interaction.
+ *
+ * Flow:
+ *   1. launcher main webview fetch POST /internal/silent-grant (mounted under /api root → effective /api/internal/silent-grant)
+ *      with `Authorization: Bearer <user's logto access_token>`
+ *      and `credentials: 'include'`
+ *   2. This endpoint verifies the token (logto JWKS) and extracts `sub`.
+ *   3. Creates a logto sign-in session for `sub` (14 days TTL).
+ *   4. Sets the logto session cookie on the response → cookie lands in the
+ *      launcher's `webview-shared/Cookies/` (since main + child webviews share
+ *      that data directory; see winamz-launcher tauri.conf.json).
+ *   5. Future child webview (e.g. vikunja) doing OIDC against logto → silent
+ *      SSO completes via the shared cookie (no sign-in page).
+ *
+ * Security:
+ *   - Caller must present a Bearer token signed by THIS logto tenant
+ *     (verified via JWKS). Effectively requires the caller to have
+ *     successfully completed a password / OIDC grant for that user.
+ *   - Token's `sub` becomes the session's accountId (no user impersonation —
+ *     the session is for the same identity that owns the token).
+ *   - 14d TTL matches logto default Session TTL.
+ *
+ * Why this exists:
+ *   OIDC SSO is cookie-based: silent SSO requires a logto session cookie in
+ *   the webview. Cookie can only be set via either (a) interactive sign-in on
+ *   logto's experience UI, or (b) this endpoint. winamz-launcher uses its own
+ *   login form (`/auth/headless-login` → password grant), which gives a token
+ *   but never establishes a sign-in session cookie. Without (b), every
+ *   embedded webview would force the user to re-authenticate.
+ */
+
+import { createLocalJWKSet, jwtVerify } from 'jose';
+
+import RequestError from '#src/errors/RequestError/index.js';
+import { extractBearerTokenFromHeaders } from '#src/middleware/koa-auth/utils.js';
+import assertThat from '#src/utils/assert-that.js';
+
+import type { AnonymousRouter, RouterInitArgs } from '../types.js';
+
+const SESSION_TTL_SECONDS = 14 * 24 * 60 * 60;
+
+export default function winamzSilentGrantRoute<T extends AnonymousRouter>(
+  ...[router, tenant]: RouterInitArgs<T>
+) {
+  // CORS preflight — global koaCors does not enable credentials, so we set
+  // Access-Control-Allow-Credentials: true locally for this endpoint to allow
+  // launcher main webview's fetch with `credentials: 'include'`.
+  const setCorsHeaders = (ctx: import('koa').Context) => {
+    const origin = ctx.request.headers.origin;
+    if (origin) {
+      ctx.set('Access-Control-Allow-Origin', origin);
+      ctx.set('Access-Control-Allow-Credentials', 'true');
+      ctx.set('Vary', 'Origin');
+    }
+  };
+  router.options('/internal/silent-grant', async (ctx) => {
+    setCorsHeaders(ctx);
+    ctx.set('Access-Control-Allow-Methods', 'POST, OPTIONS');
+    ctx.set('Access-Control-Allow-Headers', 'authorization, content-type');
+    ctx.status = 204;
+  });
+
+  // Path is /internal/silent-grant; full URL is /api/internal/silent-grant
+  // (parent app already mounted at /api, see Tenant.ts).
+  router.post('/internal/silent-grant', async (ctx) => {
+    setCorsHeaders(ctx);
+    const token = extractBearerTokenFromHeaders(ctx.request.headers);
+
+    // Verify the token using this tenant's own JWKS — guarantees the token
+    // was issued by THIS logto instance (i.e. caller already authenticated as `sub`)
+    const { publicJwks, issuer } = tenant.envSet.oidc;
+    let sub: string | undefined;
+    try {
+      const result = await jwtVerify(token, createLocalJWKSet({ keys: publicJwks }), {
+        issuer,
+      });
+      sub = typeof result.payload.sub === 'string' ? result.payload.sub : undefined;
+    } catch {
+      throw new RequestError({ code: 'auth.unauthorized', status: 401 });
+    }
+
+    assertThat(sub, new RequestError({ code: 'auth.jwt_sub_missing', status: 401 }));
+
+    // Build / reuse session via oidc-provider Session model (same one the
+    // experience UI uses internally after sign-in). `Session.get(ctx)` will
+    // create an empty session when the request has no cookie.
+    const provider = tenant.provider;
+    const session = await provider.Session.get(ctx);
+    // eslint-disable-next-line @silverhand/fp/no-mutation
+    session.accountId = sub;
+    // eslint-disable-next-line @silverhand/fp/no-mutation
+    session.loginTs = Math.floor(Date.now() / 1000);
+    await session.save(SESSION_TTL_SECONDS);
+
+    // Write the logto session cookie. oidc-provider configures its own
+    // cookieKeys (separate from koa app.keys), so we MUST use the cookies
+    // instance attached to oidc-provider's koa app — otherwise the signature
+    // (`.sig` cookie) won't verify on subsequent requests and logto will
+    // treat the session as missing.
+    const oidcCookies = provider.app.createContext(ctx.req, ctx.res).cookies;
+    oidcCookies.set(provider.cookieName('session'), session.id, {
+      httpOnly: true,
+      sameSite: 'lax',
+      maxAge: SESSION_TTL_SECONDS * 1000,
+      path: '/',
+      overwrite: true,
+      signed: true,
+    });
+
+    ctx.status = 200;
+    ctx.body = {
+      ok: true,
+      sub,
+      sessionId: session.id,
+      ttlSeconds: SESSION_TTL_SECONDS,
+    };
+  });
+}
