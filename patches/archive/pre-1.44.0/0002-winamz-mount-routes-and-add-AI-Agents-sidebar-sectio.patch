From 40f4a404af43dfb7ed93cac3cfe6cda9142678d0 Mon Sep 17 00:00:00 2001
From: wuqingabc <wuqingabc@hotmail.com>
Date: Wed, 11 Mar 2026 15:01:24 +0800
Subject: [PATCH 2/9] [winamz] mount routes and add AI Agents sidebar section
 (B-class changes)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Minimal changes to existing Logto files — cherry-pick managed for upgrades.

Files modified:
- packages/core/src/routes/init.ts: +3 lines to mount winamz routes on management router
- packages/console/src/hooks/use-console-routes/index.tsx: +5 lines to add winamz route declarations
- packages/console/src/containers/ConsoleContent/Sidebar/hook.tsx: +8 lines to add AI Agents sidebar section
- packages/phrases/src/locales/en/translation/admin-console/tabs.ts: +3 tab keys (winamz_agents, winamz_grants, winamz_audit)
- packages/phrases/src/locales/en/translation/admin-console/tab-sections.ts: +1 section key (ai_agents)

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .../ConsoleContent/Sidebar/hook.tsx           | 23 +++++++++++++++++++
 .../src/hooks/use-console-routes/index.tsx    |  8 ++++++-
 packages/core/src/routes/init.ts              |  4 ++++
 .../translation/admin-console/tab-sections.ts |  2 ++
 .../en/translation/admin-console/tabs.ts      |  4 ++++
 5 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/packages/console/src/containers/ConsoleContent/Sidebar/hook.tsx b/packages/console/src/containers/ConsoleContent/Sidebar/hook.tsx
index 872753232..96cf43093 100644
--- a/packages/console/src/containers/ConsoleContent/Sidebar/hook.tsx
+++ b/packages/console/src/containers/ConsoleContent/Sidebar/hook.tsx
@@ -2,6 +2,8 @@ import { type Optional } from '@silverhand/essentials';
 import type { TFuncKey } from 'i18next';
 import type { FC, ReactNode } from 'react';
 
+// [winamz] AI agent governance sidebar
+import AgentIcon from '@/assets/icons/hook.svg?react';
 import BarGraph from '@/assets/icons/bar-graph.svg?react';
 import Bolt from '@/assets/icons/bolt.svg?react';
 import Box from '@/assets/icons/box.svg?react';
@@ -157,6 +159,27 @@ export const useSidebarMenuItems = (): {
         },
       ],
     },
+    // [winamz] AI agent governance section
+    {
+      title: 'ai_agents',
+      items: [
+        {
+          Icon: AgentIcon,
+          title: 'winamz_agents',
+          path: 'winamz/agents',
+        },
+        {
+          Icon: List,
+          title: 'winamz_grants',
+          path: 'winamz/grants',
+        },
+        {
+          Icon: BarGraph,
+          title: 'winamz_audit',
+          path: 'winamz/audit',
+        },
+      ],
+    },
   ];
 
   const enabledSections = allSections.filter((section) => !section.isHidden);
diff --git a/packages/console/src/hooks/use-console-routes/index.tsx b/packages/console/src/hooks/use-console-routes/index.tsx
index e663d90d8..88497e8c8 100644
--- a/packages/console/src/hooks/use-console-routes/index.tsx
+++ b/packages/console/src/hooks/use-console-routes/index.tsx
@@ -21,6 +21,8 @@ import { signInExperience } from './routes/sign-in-experience';
 import { useTenantSettings } from './routes/tenant-settings';
 import { users } from './routes/users';
 import { webhooks } from './routes/webhooks';
+// [winamz] AI agent governance routes
+import { winamzAgents, winamzGrants, winamzAudit } from './routes/winamz';
 
 const Dashboard = safeLazy(async () => import('@/pages/Dashboard'));
 const GetStarted = safeLazy(async () => import('@/pages/GetStarted'));
@@ -50,7 +52,11 @@ export const useConsoleRoutes = () => {
         organizations,
         { path: 'signing-keys', element: <SigningKeys /> },
         isCloud && tenantSettings,
-        customizeJwt
+        customizeJwt,
+        // [winamz] AI agent governance routes
+        winamzAgents,
+        winamzGrants,
+        winamzAudit
       ),
     [tenantSettings]
   );
diff --git a/packages/core/src/routes/init.ts b/packages/core/src/routes/init.ts
index 125521002..320a71778 100644
--- a/packages/core/src/routes/init.ts
+++ b/packages/core/src/routes/init.ts
@@ -62,6 +62,8 @@ import verificationRoutes, { verificationApiPrefix } from './verification/index.
 import verificationCodeRoutes from './verification-code.js';
 import wellKnownRoutes from './well-known/index.js';
 import wellKnownOpenApiRoutes from './well-known/well-known.openapi.js';
+// [winamz] Import WinAMZ AI agent routes
+import winamzRoutes from './winamz/index.js';
 
 const createRouters = (tenant: TenantContext) => {
   const interactionRouter: AnonymousRouter = new Router();
@@ -117,6 +119,8 @@ const createRouters = (tenant: TenantContext) => {
   sentinelActivitiesRoutes(managementRouter, tenant);
   customProfileFieldsRoutes(managementRouter, tenant);
   secretsRoutes(managementRouter, tenant);
+  // [winamz] Mount WinAMZ AI agent routes
+  winamzRoutes(managementRouter, tenant);
 
   // General anonymous router for publicly accessible APIs
   const anonymousRouter: AnonymousRouter = new Router();
diff --git a/packages/phrases/src/locales/en/translation/admin-console/tab-sections.ts b/packages/phrases/src/locales/en/translation/admin-console/tab-sections.ts
index 2c4017dce..8ee705a5d 100644
--- a/packages/phrases/src/locales/en/translation/admin-console/tab-sections.ts
+++ b/packages/phrases/src/locales/en/translation/admin-console/tab-sections.ts
@@ -5,6 +5,8 @@ const tab_sections = {
   users: 'Users',
   developer: 'Developer',
   tenant: 'Tenant',
+  // [winamz] AI agent governance section
+  ai_agents: 'AI Agents',
 };
 
 export default Object.freeze(tab_sections);
diff --git a/packages/phrases/src/locales/en/translation/admin-console/tabs.ts b/packages/phrases/src/locales/en/translation/admin-console/tabs.ts
index f0733dd61..2a943ab1d 100644
