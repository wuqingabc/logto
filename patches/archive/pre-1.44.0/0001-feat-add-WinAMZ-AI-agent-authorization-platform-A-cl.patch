+/**
+ * WinAMZ Agent Audit Log page.
+ * Provides filterable, paginated view of all AI agent audit events.
+ *
+ * [winamz] New file - no conflict with upstream Logto updates.
+ */
+
+import { useCallback, useEffect, useState } from 'react';
+
+import DynamicT from '@/ds-components/DynamicT';
+import Search from '@/ds-components/Search';
+import Table from '@/ds-components/Table';
+import Tag from '@/ds-components/Tag';
+import useApi from '@/hooks/use-api';
+
+type AuditLog = {
+  id: string;
+  eventType: string;
+  orgId?: string | null;
+  agentId?: string | null;
+  userId?: string | null;
+  actorId?: string | null;
+  resource?: string | null;
+  metadata?: Record<string, unknown> | null;
+  createdAt: string;
+};
+
+const eventTypeColors: Record<string, 'info' | 'success' | 'error' | 'alert'> = {
+  agent_registered: 'info',
+  agent_approved: 'success',
+  agent_suspended: 'error',
+  grant_created: 'success',
+  grant_revoked: 'alert',
+  agent_action: 'info',
+  token_issued: 'info',
+};
+
+function WinamzAudit() {
+  const api = useApi();
+
+  const [logs, setLogs] = useState<AuditLog[]>([]);
+  const [total, setTotal] = useState(0);
+  const [isLoading, setIsLoading] = useState(true);
+  const [keyword, setKeyword] = useState('');
+  const [page, setPage] = useState(1);
+  const pageSize = 20;
+
+  const fetchLogs = useCallback(async () => {
+    setIsLoading(true);
+    try {
+      const params = new URLSearchParams({
+        page: String(page),
+        page_size: String(pageSize),
+      });
+      if (keyword) {
+        params.set('agent_id', keyword);
+      }
+      const response = await api
+        .get(`winamz/audit?${params.toString()}`)
+        .json<{ total: number; data: AuditLog[] }>();
+      setLogs(response.data);
+      setTotal(response.total);
+    } finally {
+      setIsLoading(false);
+    }
+  }, [api, page, keyword]);
+
+  useEffect(() => {
+    void fetchLogs();
+  }, [fetchLogs]);
+
+  return (
+    <div>
+      <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 16 }}>
+        <h1>Agent Audit Log</h1>
+        <Search
+          defaultValue={keyword}
+          isClearable={Boolean(keyword)}
+          placeholder="Filter by agent ID..."
+          onSearch={(kw) => {
+            setKeyword(kw);
+            setPage(1);
+          }}
+          onClearSearch={() => {
+            setKeyword('');
+            setPage(1);
+          }}
+        />
+      </div>
+      <Table
+        isLoading={isLoading}
+        rowIndexKey="id"
+        columns={[
+          {
+            title: 'Event',
+            dataIndex: 'eventType',
+            render: (_, log) => (
+              <Tag
+                type="state"
+                status={eventTypeColors[log.eventType] ?? 'info'}
+              >
+                {log.eventType}
+              </Tag>
+            ),
+          },
+          {
+            title: 'Agent ID',
+            dataIndex: 'agentId',
+            render: (_, log) => (
+              <span style={{ fontFamily: 'monospace', fontSize: 12 }}>
+                {log.agentId ?? '—'}
+              </span>
+            ),
+          },
+          {
+            title: 'User ID',
+            dataIndex: 'userId',
+            render: (_, log) => (
+              <span style={{ fontFamily: 'monospace', fontSize: 12 }}>
+                {log.userId ?? '—'}
+              </span>
+            ),
+          },
+          {
+            title: 'Resource',
+            dataIndex: 'resource',
+            render: (_, log) => (
+              <span style={{ fontSize: 12 }}>{log.resource ?? '—'}</span>
+            ),
+          },
+          {
+            title: 'Metadata',
+            dataIndex: 'metadata',
+            render: (_, log) =>
+              log.metadata ? (
+                <pre
+                  style={{
+                    fontSize: 11,
+                    maxWidth: 200,
+                    overflow: 'hidden',
+                    textOverflow: 'ellipsis',
+                    margin: 0,
+                  }}
+                >
+                  {JSON.stringify(log.metadata, null, 1)}
+                </pre>
+              ) : (
+                '—'
+              ),
+          },
+          {
+            title: 'Time',
+            dataIndex: 'createdAt',
+            render: (_, log) => (
+              <span style={{ fontSize: 12, whiteSpace: 'nowrap' }}>
+                {new Date(log.createdAt).toLocaleString()}
+              </span>
+            ),
+          },
+        ]}
+        rowGroups={[{ key: 'logs', data: logs }]}
+        pagination={{
+          page,
+          totalCount: total,
+          pageSize,
+          onChange: setPage,
+        }}
+        placeholder={<DynamicT forKey="general.no_results_found" />}
+      />
+    </div>
+  );
+}
+
+export default WinamzAudit;
