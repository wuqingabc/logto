diff --git a/packages/schemas/scripts/check-winamz-alteration-packaging.mjs b/packages/schemas/scripts/check-winamz-alteration-packaging.mjs
new file mode 100644
index 000000000..43ac50694
--- /dev/null
+++ b/packages/schemas/scripts/check-winamz-alteration-packaging.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import { basename, dirname } from 'node:path';
+import { test } from 'node:test';
+import { pathToFileURL } from 'node:url';
+
+import {
+  getAlterationFiles,
+  getTimestampFromFilename,
+} from '../../cli/lib/commands/database/alteration/utils.js';
+
+// Run in an isolated build/container: the real CLI refreshes its alteration-scripts directory.
+await test('WinAMZ alteration imports after the CLI copies it and remains resumable', async () => {
+  const files = await getAlterationFiles();
+  const file = files.find(
+    ({ filename }) => filename === '1.44.0-1789000001-winamz-extend-user-id-length.js'
+  );
+  assert.ok(file, 'CLI must discover the custom extension alteration');
+  assert.equal(basename(dirname(file.path)), 'alteration-scripts');
+  assert.ok(
+    getTimestampFromFilename(file.filename) > 1789000000,
+    'The extension alteration must remain after the already-applied upstream watermark'
+  );
+  const { default: alteration } = await import(pathToFileURL(file.path));
+  assert.equal(typeof alteration.up, 'function');
+  assert.equal(typeof alteration.down, 'function');
+});
diff --git a/packages/schemas/tsconfig.build.alterations.json b/packages/schemas/tsconfig.build.alterations.json
