@@ -0,0 +1,67 @@
+import Koa from 'koa';
+import Router from 'koa-router';
+import request from 'supertest';
+
+import { MockTenant } from '#src/test-utils/tenant.js';
+import { createRequester } from '#src/utils/test-utils.js';
+
+import type { ManagementApiRouter } from '../types.js';
+
+import winamzAgentRoutes from './agents.js';
+import winamzAuditRoutes from './audit.js';
+import winamzGrantRoutes from './grants.js';
+import koaWinamzTenantBoundary from './tenant-boundary.js';
+
+describe('WinAMZ global extension tenant boundary', () => {
+  const requester = (tenantId: string) => {
+    const app = new Koa();
+    const router: ManagementApiRouter = new Router();
+    router.use('/winamz', koaWinamzTenantBoundary(tenantId));
+    router.get('/winamz/agents', (ctx) => {
+      ctx.body = [{ id: 'existing-default-agent' }];
+    });
+    router.post('/winamz/grants/:id/revoke', (ctx) => {
+      ctx.body = { success: true };
+    });
+    app.use(router.routes());
+    return request(app.callback());
+  };
+
+  it.each(['admin', 'another-tenant'])(
+    'denies extension reads and writes for %s',
+    async (id) => {
+      const client = requester(id);
+      expect((await client.get('/winamz/agents')).status).toBe(403);
+      expect((await client.post('/winamz/grants/grant-id/revoke')).status).toBe(
+        403
+      );
+    }
+  );
+
+  it('preserves default tenant reads and writes', async () => {
+    const client = requester('default');
+    expect((await client.get('/winamz/agents')).body).toEqual([
+      { id: 'existing-default-agent' },
+    ]);
+    expect((await client.post('/winamz/grants/grant-id/revoke')).body).toEqual({
+      success: true,
+    });
+  });
+
+  it.each([
+    ['/winamz/agents', winamzAgentRoutes],
+    ['/winamz/grants', winamzGrantRoutes],
+    ['/winamz/audit', winamzAuditRoutes],
+  ] as const)(
+    'protects the registered %s route before database access',
+    async (path, routes) => {
+      const tenant = new MockTenant();
+      const client = createRequester({
+        authedRoutes: routes,
+        tenantContext: tenant,
+      });
+      expect((await client.get(path)).status).toBe(403);
+      expect((await client.post(path).send({})).status).toBe(403);
+    }
+  );
+});
