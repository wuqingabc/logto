@@ -0,0 +1,14 @@
+import { defaultTenantId } from '@logto/schemas';
+import type { IMiddleware } from 'koa-router';
+
+import RequestError from '#src/errors/RequestError/index.js';
+
+/** Legacy WinAMZ tables belong to the default tenant and have no tenant_id column. */
+export default function koaWinamzTenantBoundary(tenantId: string): IMiddleware {
+  return async (_ctx, next) => {
+    if (tenantId !== defaultTenantId) {
+      throw new RequestError({ code: 'auth.forbidden', status: 403 });
+    }
+    return next();
+  };
+}
