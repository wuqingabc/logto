+      );
+    } finally {
+      await connection.query(sql`ROLLBACK`);
+    }
+  });
+  console.log(
+    'PASS: 128-character references, legacy data, owner FK, safe rollback, fresh schema'
+  );
+} finally {
+  await pool.end();
+}
