diff --git a/packages/core/src/routes/winamz/silent-grant-claims.ts b/packages/core/src/routes/winamz/silent-grant-claims.ts
new file mode 100644
index 000000000..b4886e590
--- /dev/null
+++ b/packages/core/src/routes/winamz/silent-grant-claims.ts
@@ -0,0 +1,32 @@
+import type { KoaContextWithOIDC } from 'oidc-provider';
+
+/** Reserved claim: always assign this after customizable claims, even when undefined. */
+export const getSilentGrantSessionUid = (
+  ctx: KoaContextWithOIDC,
+  token: unknown
+): string | undefined => {
+  if (!(token instanceof ctx.oidc.provider.AccessToken) || !token.accountId || !token.sessionUid) {
+    return;
+  }
+  // These are the standard OAuth grant_type wire values; exchange/impersonation is excluded.
+  const source =
+    ctx.oidc.params?.grant_type === 'authorization_code'
+      ? ctx.oidc.entities.AuthorizationCode
+      : ctx.oidc.params?.grant_type === 'refresh_token'
+        ? ctx.oidc.entities.RefreshToken
+        : ctx.oidc.params?.grant_type === 'urn:ietf:params:oauth:grant-type:device_code'
+          ? ctx.oidc.entities.DeviceCode
+          : undefined;
+  if (source?.accountId === token.accountId && source.sessionUid === token.sessionUid) {
+    return token.sessionUid;
+  }
+};
+
+export const withSilentGrantSessionClaim = (
+  ctx: KoaContextWithOIDC,
+  token: unknown,
+  claims: Record<string, unknown>
+): Record<string, unknown> => ({
+  ...claims,
+  winamz_session_uid: getSilentGrantSessionUid(ctx, token),
+});
diff --git a/packages/core/src/routes/winamz/silent-grant.integration.test.mjs b/packages/core/src/routes/winamz/silent-grant.integration.test.mjs
new file mode 100644
index 000000000..5c2e6e208
--- /dev/null
+++ b/packages/core/src/routes/winamz/silent-grant.integration.test.mjs
@@ -0,0 +1,326 @@
+/**
+ * Runtime security regression suite. Uses the real pinned oidc-provider, Koa, JOSE and cookies.
+ * Run against compiled route with WINAMZ_SILENT_GRANT_MODULE pointing to its JS module.
+ * WINAMZ_TEST_RUNTIME optionally selects an isolated dependency installation.
+ */
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+import { test } from 'node:test';
+import { pathToFileURL } from 'node:url';
+
+const require = createRequire(
+  resolve(process.env.WINAMZ_TEST_RUNTIME ?? process.cwd(), 'package.json')
+);
+const load = (name) => import(pathToFileURL(require.resolve(name)));
+const [{ default: Provider }, { default: Koa }, { default: Router }, { default: request }, jose] =
+  await Promise.all(['oidc-provider', 'koa', 'koa-router', 'supertest', 'jose'].map(load));
+const { default: route } = await import(
+  process.env.WINAMZ_SILENT_GRANT_MODULE
+    ? pathToFileURL(process.env.WINAMZ_SILENT_GRANT_MODULE)
+    : new URL('./silent-grant.js', import.meta.url)
+);
+const issuer = 'https://identity.example.com/oidc';
+const clientId = 'trusted-launcher';
+const audience = 'https://api.example.com';
+const origin = 'https://launcher.example.com';
+const { privateKey, publicKey } = await jose.generateKeyPair('RS256', {
+  extractable: true,
+});
+const publicJwk = {
+  ...(await jose.exportJWK(publicKey)),
+  kid: 'test',
+  use: 'sig',
+  alg: 'RS256',
+};
+const privateJwk = {
+  ...(await jose.exportJWK(privateKey)),
+  kid: 'test',
+  use: 'sig',
+  alg: 'RS256',
+};
+process.env.WINAMZ_SILENT_GRANT_CLIENT_IDS = clientId;
+process.env.WINAMZ_SILENT_GRANT_AUDIENCES = audience;
+process.env.WINAMZ_SILENT_GRANT_ORIGINS = origin;
+const store = new Map();
+class Adapter {
+  constructor(name) {
+    this.name = name;
+  }
+  async upsert(id, payload) {
+    store.set(`${this.name}:${id}`, payload);
+  }
+  async find(id) {
+    return store.get(`${this.name}:${id}`);
+  }
+  async findByUid(uid) {
+    return [...store.entries()].find(
+      ([key, value]) => key.startsWith(`${this.name}:`) && value.uid === uid
+    )?.[1];
+  }
+  async destroy(id) {
+    store.delete(`${this.name}:${id}`);
+  }
+}
+const provider = new Provider(issuer, {
+  adapter: Adapter,
+  jwks: { keys: [privateJwk] },
+  cookies: { keys: ['cookie-key-for-test'] },
+  features: { devInteractions: { enabled: false } },
+});
+const now = Math.floor(Date.now() / 1000);
+const source = new provider.Session();
+source.loginAccount({
+  accountId: 'user-1',
+  loginTs: now - 900,
+  amr: ['pwd', 'otp'],
+  acr: 'urn:logto:acr:multi-factor',
+});
+source.grantIdFor(clientId, 'original-grant');
+await source.save(3600);
+let suspended = false;
+let thirdParty = false;
+let machine = false;
+const tenant = {
+  provider,
+  envSet: { oidc: { issuer, publicJwks: [publicJwk] } },
+  queries: {
+    users: { findUserById: async (id) => ({ id, isSuspended: suspended }) },
+    applications: {
+      findApplicationById: async (id) => ({
+        id,
+        isThirdParty: thirdParty,
+        type: machine ? 'MachineToMachine' : 'Native',
+      }),
+    },
+  },
+};
+const router = new Router();
+route(router, tenant);
+const app = new Koa();
+app.use(async (ctx, next) => {
+  try {
+    await next();
+  } catch (error) {
+    ctx.status = error.status ?? 500;
+    ctx.body = { error: error.message };
+  }
+});
+app.use(router.routes());
+const token = async (claims = {}, typ = 'at+jwt', tokenIssuer = issuer) =>
+  new jose.SignJWT({
+    sub: 'user-1',
+    client_id: clientId,
+    winamz_session_uid: source.uid,
+    aud: audience,
+    exp: now + 300,
+    ...claims,
+  })
+    .setProtectedHeader({ alg: 'RS256', kid: 'test', typ })
+    .setIssuer(tokenIssuer)
+    .setIssuedAt()
+    .sign(privateKey);
+const send = async (value, requestOrigin = origin) =>
+  request(app.callback())
+    .post('/internal/silent-grant')
+    .set('Origin', requestOrigin)
+    .set('Authorization', `Bearer ${value}`);
+
+for (const [name, claims, typ, tokenIssuer] of [
+  ['ID token', {}, 'JWT'],
+  ['wrong issuer', {}, 'at+jwt', 'https://other.example.com'],
+  ['wrong audience', { aud: 'https://other.example.com' }],
+  ['wrong client', { client_id: 'untrusted' }],
+  ['M2M subject', { sub: clientId }],
+  ['missing source session', { winamz_session_uid: undefined }],
+  ['unknown source session', { winamz_session_uid: 'missing' }],
+  ['missing client', { client_id: undefined }],
+  ['another user session', { sub: 'user-2' }],
+  ['missing expiry', { exp: undefined }],
+]) {
+  test(`rejects ${name} without setting cookies`, async () => {
+    const response = await send(await token(claims, typ, tokenIssuer));
+    assert.equal(response.status, 401, response.text);
+    assert.equal(response.headers['set-cookie'], undefined);
+  });
+}
+test('rejects suspended users', async () => {
+  suspended = true;
+  try {
+    assert.equal((await send(await token())).status, 401);
+  } finally {
+    suspended = false;
+  }
+});
+test('rejects third party clients', async () => {
+  thirdParty = true;
+  try {
+    assert.equal((await send(await token())).status, 401);
+  } finally {
+    thirdParty = false;
+  }
+});
+test('rejects machine clients', async () => {
+  machine = true;
+  try {
+    assert.equal((await send(await token())).status, 401);
+  } finally {
+    machine = false;
+  }
+});
+test('rejects untrusted origins including preflight', async () => {
+  assert.equal((await send(await token(), 'https://evil.example.com')).status, 403);
+  const response = await request(app.callback())
+    .options('/internal/silent-grant')
+    .set('Origin', 'https://evil.example.com');
+  assert.equal(response.status, 403);
+  assert.equal(response.headers['access-control-allow-credentials'], undefined);
+});
+test('primes original signed session without changing authentication or extending expiry', async () => {
+  const response = await send(await token());
+  assert.equal(response.status, 200, response.text);
+  assert.equal(response.body.sessionId, undefined);
+  const cookies = response.headers['set-cookie'];
+  assert.equal(cookies.length, 2);
+  const probe = new Koa();
+  probe.use(async (ctx) => {
+    const session = await provider.Session.get(ctx);
+    ctx.body = {
+      id: session.id,
+      accountId: session.accountId,
+      loginTs: session.loginTs,
+      amr: session.amr,
+      exp: session.exp,
+    };
+  });
+  const result = await request(probe.callback())
+    .get('/')
+    .set('Cookie', cookies.map((cookie) => cookie.split(';')[0]).join('; '));
+  assert.equal(result.body.id, source.id);
+  assert.equal(result.body.accountId, 'user-1');
+  assert.equal(result.body.loginTs, now - 900);
+  assert.deepEqual(result.body.amr, ['pwd', 'otp']);
+  assert.equal(result.body.exp, source.exp);
+  const forged = await request(probe.callback())
+    .get('/')
+    .set('Cookie', `${provider.cookieName('session')}=${source.id}`);
+  assert.equal(forged.body.accountId, undefined);
+  assert.ok(response.body.ttlSeconds <= 3600);
+});
+
+const { getSilentGrantSessionUid, withSilentGrantSessionClaim } = await import(
+  process.env.WINAMZ_SILENT_GRANT_CLAIMS_MODULE
+    ? pathToFileURL(process.env.WINAMZ_SILENT_GRANT_CLAIMS_MODULE)
+    : new URL('./silent-grant-claims.js', import.meta.url)
+);
+const client = { clientId };
+for (const [grantType, entityName, Entity] of [
+  ['authorization_code', 'AuthorizationCode', provider.AuthorizationCode],
+  ['refresh_token', 'RefreshToken', provider.RefreshToken],
+  ['urn:ietf:params:oauth:grant-type:device_code', 'DeviceCode', provider.DeviceCode],
+]) {
+  test(`trusted session UID is preserved only from bound ${grantType}`, () => {
+    const properties = {
+      client,
+      accountId: 'user-1',
+      sessionUid: source.uid,
+      grantId: 'original-grant',
+      scope: 'openid',
+    };
+    const accessToken = new provider.AccessToken(properties);
+    const sourceToken = new Entity({
+      ...properties,
+      params: {},
+      userCode: 'ABCD-EFGH',
+      deviceInfo: {},
+    });
+    const ctx = {
+      oidc: {
+        provider,
+        params: { grant_type: grantType },
+        entities: { [entityName]: sourceToken },
+      },
+    };
+    assert.equal(getSilentGrantSessionUid(ctx, accessToken), source.uid);
+    assert.equal(
+      getSilentGrantSessionUid(
+        ctx,
+        new provider.AccessToken({ ...properties, accountId: 'other-user' })
+      ),
+      undefined
+    );
+    assert.equal(
+      getSilentGrantSessionUid(
+        ctx,
+        new provider.AccessToken({ ...properties, sessionUid: 'injected' })
+      ),
+      undefined
+    );
+    assert.equal(getSilentGrantSessionUid(ctx, { ...properties }), undefined);
+    assert.equal(
+      getSilentGrantSessionUid(
+        {
+          oidc: {
+            ...ctx.oidc,
+            params: {
+              grant_type: 'urn:ietf:params:oauth:grant-type:token-exchange',
+            },
+          },
+        },
+        accessToken
+      ),
+      undefined
+    );
+    assert.equal(
+      getSilentGrantSessionUid({ oidc: { ...ctx.oidc, entities: {} } }, accessToken),
+      undefined
+    );
+  });
+}
+test('rejects expired JWT without setting a cookie', async () => {
+  const response = await send(await token({ exp: now - 60 }));
+  assert.equal(response.status, 401);
+  assert.equal(response.headers['set-cookie'], undefined);
+});
+test('logout of original session invalidates priming', async () => {
+  await source.destroy();
+  const response = await send(await token());
+  assert.equal(response.status, 401);
+  assert.equal(response.headers['set-cookie'], undefined);
+});
+
+test('custom claims cannot inject or overwrite the reserved session UID', () => {
+  const properties = {
+    client,
+    accountId: 'user-1',
+    sessionUid: source.uid,
+    grantId: 'original-grant',
+    scope: 'openid',
+  };
+  const accessToken = new provider.AccessToken(properties);
+  const ctx = {
+    oidc: {
+      provider,
+      params: { grant_type: 'authorization_code' },
+      entities: { AuthorizationCode: new provider.AuthorizationCode(properties) },
+    },
+  };
+  assert.equal(
+    withSilentGrantSessionClaim(ctx, accessToken, { winamz_session_uid: 'injected', custom: true })
+      .winamz_session_uid,
+    source.uid
+  );
+  assert.equal(
+    withSilentGrantSessionClaim(
+      { oidc: { ...ctx.oidc, params: { grant_type: 'client_credentials' } } },
+      accessToken,
+      { winamz_session_uid: 'injected' }
+    ).winamz_session_uid,
+    undefined
+  );
+  assert.equal(
+    withSilentGrantSessionClaim(ctx, { ...properties }, { winamz_session_uid: 'injected' })
+      .winamz_session_uid,
+    undefined
+  );
+});
diff --git a/packages/core/src/routes/winamz/silent-grant.ts b/packages/core/src/routes/winamz/silent-grant.ts
index 160c36f33..afed6378a 100644
--- a/packages/core/src/routes/winamz/silent-grant.ts
+++ b/packages/core/src/routes/winamz/silent-grant.ts
@@ -1,40 +1,8 @@
 /**
- * [winamz] New file - silent SSO endpoint for trusted launcher.
- *
- * Allows winamz-launcher (after headless-login obtains a logto access_token)
- * to "prime" a logto sign-in session cookie in the launcher's main webview,
- * so that any embedded child webview (vikunja / future) gets silent SSO when
- * doing OIDC code flow against logto — no user interaction.
- *
- * Flow:
- *   1. launcher main webview fetch POST /internal/silent-grant (mounted under /api root → effective /api/internal/silent-grant)
- *      with `Authorization: Bearer <user's logto access_token>`
- *      and `credentials: 'include'`
- *   2. This endpoint verifies the token (logto JWKS) and extracts `sub`.
- *   3. Creates a logto sign-in session for `sub` (14 days TTL).
- *   4. Sets the logto session cookie on the response → cookie lands in the
- *      launcher's `webview-shared/Cookies/` (since main + child webviews share
- *      that data directory; see winamz-launcher tauri.conf.json).
- *   5. Future child webview (e.g. vikunja) doing OIDC against logto → silent
- *      SSO completes via the shared cookie (no sign-in page).
- *
- * Security:
- *   - Caller must present a Bearer token signed by THIS logto tenant
- *     (verified via JWKS). Effectively requires the caller to have
- *     successfully completed a password / OIDC grant for that user.
- *   - Token's `sub` becomes the session's accountId (no user impersonation —
- *     the session is for the same identity that owns the token).
- *   - 14d TTL matches logto default Session TTL.
- *
- * Why this exists:
- *   OIDC SSO is cookie-based: silent SSO requires a logto session cookie in
- *   the webview. Cookie can only be set via either (a) interactive sign-in on
- *   logto's experience UI, or (b) this endpoint. winamz-launcher uses its own
