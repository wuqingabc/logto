+      await connection.query(sql`INSERT INTO users VALUES (${userId})`);
+      await connection.query(sql`
+        INSERT INTO winamz_agents (id, name, type, org_id, owner_user_id)
+        VALUES ('fresh-agent', 'Fresh', 'personal', 'legacy-org', ${userId})
+      `);
+      await connection.query(
+        sql`DELETE FROM organizations WHERE id = 'legacy-org'`
+      );
+      assert.equal(
+        (
+          await connection.one(
+            sql`SELECT count(*)::integer AS count FROM winamz_agents`
+          )
