+import assert from 'node:assert/strict';
+
+import { createPool, sql } from '@silverhand/slonik';
+
+// Only use a disposable database. All fixtures and DDL roll back, including on failure.
+const databaseUrl = process.env.WINAMZ_TEST_DATABASE_URL;
+assert.ok(
+  databaseUrl,
+  'Set WINAMZ_TEST_DATABASE_URL to a disposable PostgreSQL database'
+);
+const pool = await createPool(databaseUrl);
+const baseline = process.argv.includes('--baseline');
+const alteration = baseline
+  ? undefined
+  : (
+      await import(
+        '../alterations-js/1.44.0-1789000001-winamz-extend-user-id-length.js'
+      )
+    ).default;
+
+try {
+  await pool.connect(async (connection) => {
+    await connection.query(sql`BEGIN`);
+    try {
+      await connection.query(sql`CREATE SCHEMA winamz_id_width_test`);
+      await connection.query(
+        sql`SET LOCAL search_path TO winamz_id_width_test`
+      );
+      await connection.query(sql`
+        CREATE TABLE users (id varchar(128) PRIMARY KEY);
+        CREATE TABLE organizations (id varchar(21) PRIMARY KEY);
+        CREATE TABLE winamz_agents (
+          id varchar(21) PRIMARY KEY,
+          org_id varchar(21),
+          owner_user_id varchar(21),
+          CONSTRAINT fk_winamz_agents_owner FOREIGN KEY (owner_user_id)
+            REFERENCES users(id) ON DELETE SET NULL,
+          CONSTRAINT fk_winamz_agents_org FOREIGN KEY (org_id)
+            REFERENCES organizations(id) ON DELETE CASCADE
+        );
+        CREATE TABLE winamz_agent_grants (
+          id varchar(21) PRIMARY KEY,
+          user_id varchar(21) NOT NULL,
+          revoked_by varchar(21)
+        );
+        CREATE TABLE winamz_audit_logs (
+          id varchar(21) PRIMARY KEY,
+          user_id varchar(21),
+          actor_id varchar(21)
+        );
+        INSERT INTO users VALUES ('legacy-user');
+        INSERT INTO organizations VALUES ('legacy-org');
+        INSERT INTO winamz_agents VALUES ('legacy-agent', 'legacy-org', 'legacy-user');
+        INSERT INTO winamz_agent_grants VALUES ('legacy-grant', 'legacy-user', 'legacy-user');
+        INSERT INTO winamz_audit_logs VALUES ('legacy-audit', 'legacy-user', 'legacy-user');
+      `);
+
+      await alteration?.up(connection);
+      const userId = 'u'.repeat(128);
+      await connection.query(sql`INSERT INTO users VALUES (${userId})`);
+      await connection.query(
+        sql`INSERT INTO winamz_agents VALUES ('long-agent', 'legacy-org', ${userId})`
+      );
+      await connection.query(
+        sql`INSERT INTO winamz_agent_grants VALUES ('long-grant', ${userId}, ${userId})`
+      );
+      await connection.query(
+        sql`INSERT INTO winamz_audit_logs VALUES ('long-audit', ${userId}, ${userId})`
+      );
+      const legacy = await connection.one(sql`
+        SELECT a.owner_user_id, g.user_id, g.revoked_by, l.user_id AS audit_user_id, l.actor_id
+        FROM winamz_agents a, winamz_agent_grants g, winamz_audit_logs l
+        WHERE a.id = 'legacy-agent' AND g.id = 'legacy-grant' AND l.id = 'legacy-audit'
+      `);
+      assert.deepEqual(Object.values(legacy), Array(5).fill('legacy-user'));
+
+      // Widening must retain the owner FK and its delete action.
+      await connection.query(sql`DELETE FROM users WHERE id = ${userId}`);
+      assert.equal(
+        (
+          await connection.one(
+            sql`SELECT owner_user_id FROM winamz_agents WHERE id = 'long-agent'`
+          )
+        ).owner_user_id,
+        null
+      );
+      await connection.query(sql`SAVEPOINT rollback_check`);
+      await assert.rejects(alteration.down(connection), /value too long/);
+      await connection.query(sql`ROLLBACK TO SAVEPOINT rollback_check`);
+      assert.equal(
+        (
+          await connection.one(
+            sql`SELECT user_id FROM winamz_agent_grants WHERE id = 'long-grant'`
+          )
+        ).user_id,
+        userId
+      );
+
+      await connection.query(
+        sql`DELETE FROM winamz_agent_grants WHERE id = 'long-grant'`
+      );
+      await connection.query(
+        sql`DELETE FROM winamz_audit_logs WHERE id = 'long-audit'`
+      );
+      await alteration.down(connection);
+      const widths = await connection.any(sql`
+        SELECT character_maximum_length FROM information_schema.columns
+        WHERE table_schema = 'winamz_id_width_test'
+          AND column_name IN ('owner_user_id', 'user_id', 'revoked_by', 'actor_id')
