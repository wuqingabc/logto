@@ -0,0 +1,56 @@
+import { sql } from '@silverhand/slonik';
+
+import { up as createTables } from '../lib/migrations/winamz-001-create-tables.js';
+import { up as addForeignKeys } from '../lib/migrations/winamz-002-add-fk-constraints.js';
+import type { AlterationScript } from '../lib/types/alteration.js';
+
+const columns = [
+  ['winamz_agents', 'owner_user_id'],
+  ['winamz_agent_grants', 'user_id'],
+  ['winamz_agent_grants', 'revoked_by'],
+  ['winamz_audit_logs', 'user_id'],
+  ['winamz_audit_logs', 'actor_id'],
+] as const;
+
+/** Extend custom user references after upstream 1.44 widens users.id. */
+const alteration: AlterationScript = {
+  up: async (pool) => {
+    const { present } = await pool.one<{ present: number }>(sql`
+      select count(*)::integer as present from pg_class
+      where oid in (
+        to_regclass('winamz_agents'), to_regclass('winamz_agent_grants'),
+        to_regclass('winamz_audit_logs')
+      )
+    `);
+    if (present === 0) {
+      // Canonical creation also installs the extension indexes, RLS, and permissions.
+      await pool.query(sql.raw(createTables));
+      await pool.query(sql.raw(addForeignKeys));
+    } else if (present !== 3) {
+      throw new Error(
+        'Incomplete WinAMZ schema: restore missing extension tables before upgrading'
+      );
+    }
+
+    for (const [table, column] of columns) {
+      // eslint-disable-next-line no-await-in-loop -- DDL statements must run sequentially
+      await pool.query(sql`
+        alter table ${sql.identifier([table])}
+        alter column ${sql.identifier([column])} type varchar(128)
+      `);
+    }
+  },
+  down: async (pool) => {
+    // PostgreSQL rejects values exceeding 21 characters; never truncate identity references.
+    // Keep extension tables and all legacy data even when this alteration created them.
+    for (const [table, column] of columns) {
+      // eslint-disable-next-line no-await-in-loop -- DDL statements must run sequentially
+      await pool.query(sql`
+        alter table ${sql.identifier([table])}
+        alter column ${sql.identifier([column])} type varchar(21)
+      `);
+    }
+  },
+};
+
+export default alteration;
