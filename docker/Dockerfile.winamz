# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
FROM ${NODE_IMAGE} AS dependencies
ARG APK_MIRROR=https://mirrors.aliyun.com/alpine
WORKDIR /app
ENV CI=true PUPPETEER_SKIP_DOWNLOAD=true NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
RUN sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${APK_MIRROR}|g" /etc/apk/repositories && apk add --no-cache python3 make g++ git rsync tini
RUN npm install --global pnpm@10.33.2
COPY .deps/ /app/
RUN --mount=type=cache,id=winamz-logto144-pnpm,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY . /app/
RUN pnpm install --offline --frozen-lockfile
RUN pnpm -r build
RUN pnpm cli connector link -p .

FROM ${NODE_IMAGE} AS runtime
ARG APK_MIRROR=https://mirrors.aliyun.com/alpine
RUN sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${APK_MIRROR}|g" /etc/apk/repositories && apk add --no-cache tini
WORKDIR /app
COPY --from=builder /app /app
ARG UPSTREAM_VERSION=v1.44.0
ARG WINAMZ_BUILD_N=0
ARG WINAMZ_REVISION
ENV NODE_ENV=production WINAMZ_UPSTREAM_VERSION=${UPSTREAM_VERSION} WINAMZ_BUILD_N=${WINAMZ_BUILD_N}
LABEL org.opencontainers.image.version="${UPSTREAM_VERSION}-winamz.${WINAMZ_BUILD_N}" \
      org.opencontainers.image.revision="${WINAMZ_REVISION}" \
      org.winamz.upstream="logto" \
      org.winamz.upstream-version="${UPSTREAM_VERSION}"
EXPOSE 4000 4001
ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "cd packages/core && node ."]
