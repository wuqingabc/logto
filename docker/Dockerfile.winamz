# WinAMZ logto 镜像（Patch Stack 模式，详见 ADR-013）
#
# 构建上下文：logto/ submodule（patch 已在外部 apply 后）
# 调用方式：bash scripts/build-image.sh（不要直接 docker build）

ARG UPSTREAM_VERSION=v1.37.1
FROM node:22-alpine AS builder

# 安装构建依赖（apk 走阿里云镜像,避免国内拉 alpine CDN 慢）
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories && \
    apk add --no-cache python3 make g++ git rsync

WORKDIR /app
COPY --link . /app/

# 安装 + 构建（patch 已 apply 到工作树）
# pnpm pin@10:corepack enable 默认激活 pnpm 11,违反 logto engines pnpm ^9||^10
#                              → ERR_PNPM_UNSUPPORTED_ENGINE。官方 Dockerfile 也用 pnpm@^10。
# npmmirror:避免国内拉 registry.npmjs.org 卡死;CI=true 非交互
ENV CI=true
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate && \
    pnpm config set registry https://registry.npmmirror.com && \
    pnpm install --frozen-lockfile=false
RUN pnpm prepack && pnpm -r build

# Add official connectors —— 对齐 logto 官方 Dockerfile(line 31):把 connector packages
# link 到 packages/core/connectors/,否则 connector-factories=[] → SSO 等 connector 全不可用。
# 之前 winamz 镜像漏这步,dev 实例靠手动 symlink 临时绕过(见 ADR-013 / A2 交接文档)。
RUN pnpm cli connector link -p .

# Runtime stage
FROM node:22-alpine AS runtime
RUN apk add --no-cache tini
WORKDIR /app

COPY --from=builder /app /app

ARG WINAMZ_BUILD_N=0
ENV WINAMZ_BUILD_N=${WINAMZ_BUILD_N}
ENV WINAMZ_UPSTREAM_VERSION=${UPSTREAM_VERSION}

LABEL org.winamz.upstream="logto"
LABEL org.winamz.upstream-version="${UPSTREAM_VERSION}"
LABEL org.winamz.build-n="${WINAMZ_BUILD_N}"

EXPOSE 3001 3002
ENTRYPOINT ["tini", "--"]
CMD ["sh", "-c", "cd packages/core && NODE_ENV=production node ."]
